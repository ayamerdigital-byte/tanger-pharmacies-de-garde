---
import { readFeed, latestRelevant, localNow } from '../../../lib/feed.js';
import '../../../styles/global.css';

export function getStaticPaths() {
  return [{ params: { lang: 'fr' } }, { params: { lang: 'ar' } }];
}

const lang = Astro.params.lang;
if (!['fr', 'ar'].includes(lang)) return new Response('Not found', { status: 404 });
const isArabic = lang === 'ar';
const feed = await readFeed();
const now = localNow();
const isStatic = process.env.DEPLOY_TARGET === 'github-pages';
const latestDate = feed.posts.map(post => post.date).sort().at(-1);
const selection = isStatic ? { posts: feed.posts.filter(post => post.date === latestDate), active: false } : latestRelevant(feed.posts, now);
const locale = isArabic ? 'ar-MA' : 'fr-MA';
const dateLabel = new Intl.DateTimeFormat(locale, { timeZone: isStatic ? 'UTC' : 'Africa/Casablanca', weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).format(isStatic && latestDate ? new Date(`${latestDate}T12:00:00Z`) : new Date());
const checkedLabel = feed.lastCheckedAt ? new Intl.DateTimeFormat(locale, { timeZone: 'Africa/Casablanca', dateStyle: 'medium', timeStyle: 'short' }).format(new Date(feed.lastCheckedAt)) : null;
const title = isArabic ? (isStatic ? 'صيدليات الحراسة بطنجة' : 'صيدليات الحراسة بطنجة اليوم') : (isStatic ? 'Pharmacies de garde à Tanger' : 'Pharmacies de garde à Tanger aujourd’hui');
const description = isArabic ? 'اطلع على لائحة صيدليات الحراسة بطنجة، التوقيت، وتاريخ آخر تحقق من المصدر.' : 'Consultez les pharmacies de garde à Tanger, les horaires et la date de la dernière vérification de la source.';
const site = import.meta.env.SITE || 'http://localhost:4321';
const base = import.meta.env.BASE_URL;
const withBase = (value) => `${base.replace(/\/$/, '')}/${value.replace(/^\//, '')}`;
const path = `/${lang}/tanger/pharmacies-de-garde/`;
const alternate = `/${isArabic ? 'fr' : 'ar'}/tanger/pharmacies-de-garde/`;
const t = isArabic ? {
  subtitle: 'لائحة الحراسة من المصدر المحلي', current: 'الحراسة الجارية', latest: 'آخر لائحة منشورة',
  checked: 'آخر تحقق من المصدر', source: 'افتح صفحة المصدر', day: 'حراسة النهار', night: 'حراسة الليل', other: 'لائحة الحراسة',
  time: 'التوقيت', note: 'تأكد من التاريخ والتوقيت، واتصل بالصيدلية قبل التوجه إليها.',
  empty: 'لا توجد لائحة مؤكدة متاحة الآن.', emptyDetail: 'راجع صفحة المصدر للحصول على أحدث لائحة.',
  image: 'افتح الصورة بحجم أكبر', about: 'كيف نعرض هذه اللوائح', aboutText: 'ننقل صور اللوائح والتوقيت من صفحة صيدليات الحراسة بطنجة. التحقق الآلي لا يؤكد أن الصيدلية مفتوحة فعلاً؛ اتصل بها قبل التنقل. إذا تعذر جلب منشور جديد، نعرض تاريخ آخر تحقق بوضوح.',
  latestWarning: 'هذه اللائحة ليست مؤكدة للحراسة الجارية. تحقق من المصدر قبل التنقل.',
  language: 'Français', archive: 'بطاقات الصيدليات المنشورة',
} : {
  subtitle: 'Le planning, directement depuis la source locale', current: 'Garde en cours', latest: 'Dernier planning publié',
  checked: 'Dernière vérification de la source', source: 'Voir la page source', day: 'Garde de jour', night: 'Garde de nuit', other: 'Planning de garde',
  time: 'Horaires', note: 'Vérifiez la date et les horaires, puis appelez la pharmacie avant de vous déplacer.',
  empty: 'Aucun planning confirmé disponible pour le moment.', emptyDetail: 'Consultez la page source pour le planning le plus récent.',
  image: 'Agrandir la carte', about: 'Comment ce site utilise les plannings', aboutText: 'Nous reprenons les cartes et les horaires de la page Pharmacies de garde à Tanger. La vérification automatique ne confirme pas qu’une pharmacie est effectivement ouverte : appelez avant de partir. Si un nouveau post est inaccessible, la date de la dernière vérification reste visible.',
  latestWarning: 'Ce planning n’est pas confirmé pour la garde en cours. Vérifiez la source avant de partir.',
  language: 'العربية', archive: 'Cartes des pharmacies publiées',
};
const shiftName = (shift) => t[shift] || t.other;
const formatPostDate = (date) => new Intl.DateTimeFormat(locale, { timeZone: 'UTC', weekday: 'long', day: 'numeric', month: 'long' }).format(new Date(`${date}T12:00:00Z`));
---
<!doctype html>
<html lang={lang} dir={isArabic ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b5267" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={new URL(withBase(path), site).href} />
    <link rel="alternate" hreflang="fr-MA" href={new URL(withBase('/fr/tanger/pharmacies-de-garde/'), site).href} />
    <link rel="alternate" hreflang="ar-MA" href={new URL(withBase('/ar/tanger/pharmacies-de-garde/'), site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(withBase('/fr/tanger/pharmacies-de-garde/'), site).href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip" href="#main">{isArabic ? 'انتقل إلى اللائحة' : 'Aller au planning'}</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={withBase(path)} aria-label={title}><span class="cross" aria-hidden="true"></span><span>Tanger<span class="brand-small">{isArabic ? 'صيدليات الحراسة' : 'Pharmacies de garde'}</span></span></a>
        <a class="language" href={withBase(alternate)} lang={isArabic ? 'fr' : 'ar'}>{t.language}</a>
      </div>
    </header>
    <main id="main" class="wrap">
      <section class="intro" aria-labelledby="page-title">
        <p class="city">Tanger · طنجة</p>
        <h1 id="page-title">{title}</h1>
        <p class="subtitle">{t.subtitle}</p>
        <div class="today"><span class="pulse" aria-hidden="true"></span><time datetime={isStatic ? latestDate || now.date : now.date}>{dateLabel}</time>{!isStatic && <span class="today-time">{now.time}</span>}</div>
      </section>

      <section class="roster" aria-labelledby="roster-title">
        <div class="roster-head">
          <div><h2 id="roster-title">{selection.active ? t.current : t.latest}</h2><p class="source-time">{t.checked} : <strong>{checkedLabel || '—'}</strong></p></div>
          <a class="source-link" href={feed.source} target="_blank" rel="noopener noreferrer">{t.source}<span aria-hidden="true">↗</span></a>
        </div>
        {selection.posts.length === 0 ? <div class="empty"><p>{t.empty}</p><p>{t.emptyDetail}</p></div> : <>
          {!selection.active && <p class="warning" role="status">{t.latestWarning}</p>}
          <div class="shift-list">
            {selection.posts.map(post => <article class="shift">
              <div class="shift-heading"><div><span class="shift-icon" aria-hidden="true">{post.shift === 'night' ? '◐' : '✳'}</span><h3>{shiftName(post.shift)}</h3></div><time datetime={post.date}>{formatPostDate(post.date)}</time></div>
              {post.interval && <p class="hours"><span>{t.time}</span><strong dir="ltr">{post.interval.start} – {post.interval.end}</strong></p>}
              <p class="important">{t.note}</p>
              <h4>{t.archive} <span>({post.images.length})</span></h4>
              <div class="cards">
                {post.images.map((image, index) => <a class="card" href={withBase(image)} target="_blank" rel="noopener noreferrer" aria-label={`${t.image} ${index + 1}`}><img src={withBase(image)} alt={`${shiftName(post.shift)} : ${formatPostDate(post.date)}, ${index + 1}`} loading={index > 1 ? 'lazy' : 'eager'} decoding="async" /><span>{t.image}<span aria-hidden="true">↗</span></span></a>)}
              </div>
            </article>)}
          </div>
        </>}
      </section>
      <section class="about" aria-labelledby="about-title"><h2 id="about-title">{t.about}</h2><p>{t.aboutText}</p><a href={feed.source} target="_blank" rel="noopener noreferrer">{t.source}</a></section>
    </main>
    <footer class="footer"><div class="wrap">Tanger · طنجة <span>{new Date().getFullYear()}</span></div></footer>
  </body>
</html>
