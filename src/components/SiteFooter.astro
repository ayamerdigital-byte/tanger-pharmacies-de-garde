---
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const to = (path) => `${base}/${lang}/${path}`;
const labels = lang === 'ar'
  ? { nav: 'روابط الموقع', home: 'لائحة الصيدليات', about: 'عن الموقع', privacy: 'الخصوصية', terms: 'شروط الاستخدام' }
  : { nav: 'Liens du site', home: 'Pharmacies de garde', about: 'À propos', privacy: 'Confidentialité', terms: 'Conditions d’utilisation' };
---
<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">Tanger · طنجة <span>{new Date().getFullYear()}</span></div>
    <nav class="footer-nav" aria-label={labels.nav}>
      <a href={to('tanger/pharmacies-de-garde/')}>{labels.home}</a>
      <a href={to('about/')}>{labels.about}</a>
      <a href={to('privacy/')}>{labels.privacy}</a>
      <a href={to('terms/')}>{labels.terms}</a>
    </nav>
  </div>
</footer>
<style>
  .footer .footer-inner{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:24px 0}
  .footer-brand{display:flex;align-items:center;gap:10px;white-space:nowrap}
  .footer-brand span{opacity:.75}
  .footer-nav{display:flex;flex-wrap:wrap;gap:8px 18px}
  .footer-nav a{color:#e0f1ee;text-decoration:underline;text-underline-offset:3px;font-size:.88rem}
  .footer-nav a:hover{color:#fff}
  @media(max-width:760px){.footer .footer-inner{align-items:flex-start;flex-direction:column}.footer-nav{gap:10px 16px}}
</style>
